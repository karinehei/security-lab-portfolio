NODE_ENV=development
PORT=3000
LISTEN_HOST=127.0.0.1

# Local PostgreSQL from docker-compose.yml (loopback only)
DATABASE_URL=postgresql://lab:lab@127.0.0.1:5432/documents_lab

# Fictional lab secret — never reuse in another environment
JWT_SECRET=local-lab-jwt-secret-not-for-production

# vulnerable | secure
# Application code defaults to secure if this is omitted.
# Use vulnerable only on localhost for training.
LAB_MODE=vulnerable
