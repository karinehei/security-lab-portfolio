{
  "name": "ai-security-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Local synthetic RAG pipeline for document-level access-control training. No external LLM APIs.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ask": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:all",
    "test:secure": "cross-env LAB_MODE=secure vitest run",
    "test:vulnerable": "cross-env LAB_MODE=vulnerable vitest run",
    "test:all": "npm run test:secure && npm run test:vulnerable"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "cross-env": "^10.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
